pipeline {
    agent any
    
    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out code...'
                checkout scm
            }
        }
        
        stage('Build') {
            steps {
                echo 'Starting the build process...'
                bat 'echo Build completed successfully. > build.log'
                bat 'dir'
            }
        }
        
        stage('Test') {
            steps {
                echo 'Running tests...'
                bat 'echo All tests passed > test-results.log'
            }
        }
        
        stage('Deploy') {
            steps {
                echo 'Deployment stage...'
                bat 'echo Deployment completed > deploy.log'
            }
        }
    }
    
    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed!'
        }
    }
}
